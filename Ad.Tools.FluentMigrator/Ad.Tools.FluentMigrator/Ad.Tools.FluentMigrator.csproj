<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild> <!-- Modificato da true a false -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">C:\sviluppo\AdToolsPackages</PackageOutputPath>
    <PackageOutputPath Condition="!$([MSBuild]::IsOSPlatform('Windows'))">bin/Packages</PackageOutputPath>
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
    <PackageReference Include="FluentMigrator.Runner" Version="8.0.1" />
    <PackageReference Include="MySql.Data" Version="8.0.25" />
    <!-- La libreria con cui le migrazioni aprono SQLite: la stessa di NHibernate (SystemDataSQLiteDbFactory). -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

</Project>
