# Copia questo file in "docker/.env" e compilalo: docker compose lo legge da solo.
# Il .env vero NON e' versionato — puo' contenere un PAT GitHub.

# --- Windows-only required configuration -------------------------------------
# On macOS and Linux you can DELETE this file: docker-compose.yml falls back to
# ${PWD}/workspace, which bash/zsh propagate as an env var to child processes.
#
# On Windows (PowerShell, cmd) $PWD is NOT propagated to docker-compose, so
# the fallback resolves to an empty path. Set the absolute path here.
# Forward slashes are fine on Windows; VS Code accepts them.
# Update this if you relocate the docker/ folder.
MDE_HOST_WORKSPACE=C:/sviluppo/mdExplorer/docker/workspace

# --- GitHub Copilot CLI (optional) -------------------------------------------
# Token for headless Copilot authentication. Use a fine-grained Personal Access
# Token with the "Copilot Requests" permission (github.com → Settings →
# Developer settings → Fine-grained tokens), or a classic PAT with the
# user:email and read:org scopes. With this set, the in-app AI chat works
# immediately — no interactive login.
# Leave blank to instead run `docker compose exec mde copilot` and use /login.
COPILOT_GITHUB_TOKEN=
