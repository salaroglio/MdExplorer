<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <!-- Guardia anti-regressione della catena di migrazioni: stesso driver pinnato
         dal Service (1.0.119 dal 21/11/2026, L1a). 1.0.114.4 regrediva PRAGMA table_info. -->
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdExplorer.bll\MdExplorer.Features.csproj" />
    <ProjectReference Include="..\MdExplorer.RemoteAgent\MdExplorer.RemoteAgent.csproj" />
    <ProjectReference Include="..\MdExplorer.Migrations\MdExplorer.Migrations.csproj" />
    <ProjectReference Include="..\Ad.Tools.FluentMigrator\Ad.Tools.FluentMigrator\Ad.Tools.FluentMigrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il Fuseki del pacchetto (D19): i test del grafo del codice lo avviano dal jar vero. -->
    <None Include="..\MdExplorer\Binaries\jena-fuseki-server.jar" Link="Binaries\jena-fuseki-server.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Commands\TestStore\ChangeLinkIntoCallAJavscriptFunction.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="WordTests\FilesDocx\PrimaPaginaTitolo.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="WordTests\FilesDocx\Test1.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="WordTests\FilesDocx\testobase.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Yaml\Inputs\NormalYaml.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Yaml\Inputs\ParseYaml.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Yaml\ExpectedOutputs\" />
  </ItemGroup>

</Project>
