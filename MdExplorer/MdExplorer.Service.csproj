<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- System.Data.SQLite.Core 1.0.113.1 spedisce lo STESSO SQLite.Interop.dll (byte identici)
       sia in runtimes/win-x64/native/netstandard2.0 sia in .../netstandard2.1. Nel publish
       entrambi finirebbero su "SQLite.Interop.dll" e .NET 8 si ferma con NETSDK1152
       ("multiple publish output files with the same relative path"). Teniamo netstandard2.1. -->
  <Target Name="DropDuplicateSQLiteInterop" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'SQLite.Interop.dll' And $([MSBuild]::ValueOrDefault('%(FullPath)', '').Contains('netstandard2.0'))" />
    </ItemGroup>
    <PropertyGroup>
      <_SQLiteInteropCount>@(ResolvedFileToPublish->WithMetadataValue('Filename', 'SQLite.Interop')->Count())</_SQLiteInteropCount>
    </PropertyGroup>
    <!-- Fail-loud: se il filtro le togliesse entrambe il publish riuscirebbe lo stesso, e l'app
         morirebbe a runtime con "Unable to load DLL 'SQLite.Interop.dll'" al primo accesso al DB. -->
    <Error Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(_SQLiteInteropCount)' != '1'"
           Text="Attesa 1 copia di SQLite.Interop.dll nel publish, trovate $(_SQLiteInteropCount). Il filtro di DropDuplicateSQLiteInterop non e' piu' allineato al layout di System.Data.SQLite.Core." />
  </Target>

  <Target Name="PostPublish" AfterTargets="AfterPublish">
    <Message Text="BEGIN After-publish PublishDir=$(PublishDir) PublishUrl=$(PublishUrl)" Importance="high" />
    <Copy SourceFiles="$(OutDir)Binaries\Plantuml.jar"
          DestinationFiles="$(PublishUrl)\Plantuml.jar"
          Condition="'$(PublishUrl)' != '' And Exists('$(OutDir)Binaries\Plantuml.jar')" />
    <Message Text="END After-publish" Importance="high" />

    <!-- Build P2P Premium module if project exists -->
    <PropertyGroup>
      <P2PProjectPath>$(MSBuildThisFileDirectory)..\MdExplorer.P2P.Premium\MdExplorer.P2P.Premium.csproj</P2PProjectPath>
      <P2PDllSource>$(MSBuildThisFileDirectory)..\MdExplorer.P2P.Premium\bin\Release\net8.0\MdExplorer.P2P.Premium.dll</P2PDllSource>
      <P2PDllDest>$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.P2P.Premium.dll</P2PDllDest>
    </PropertyGroup>

    <!-- Build P2P Premium in Release mode if the project file exists -->
    <Message Text="Building MdExplorer.P2P.Premium..." Importance="high" Condition="Exists('$(P2PProjectPath)')" />
    <Exec Command="dotnet build &quot;$(P2PProjectPath)&quot; -c Release" Condition="Exists('$(P2PProjectPath)')" ContinueOnError="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="P2PBuildExitCode" />
    </Exec>
    <Message Text="P2P Premium build completed (exit code: $(P2PBuildExitCode))" Importance="high" Condition="Exists('$(P2PProjectPath)')" />

    <!-- Copy P2P Premium DLL to service_payload -->
    <Copy SourceFiles="$(P2PDllSource)"
          DestinationFiles="$(P2PDllDest)"
          Condition="Exists('$(P2PDllSource)')"
          ContinueOnError="true" />
    <Message Text="Copied MdExplorer.P2P.Premium.dll to service_payload" Importance="high"
             Condition="Exists('$(P2PDllSource)')" />
    <Message Text="P2P Premium DLL not found - skipping copy" Importance="high"
             Condition="!Exists('$(P2PDllSource)')" />

    <!-- Publish the MdExplorer.Mcp stdio server into its OWN isolated subfolder
         service_payload/mcp (-> app_service/mcp), NOT next to MdExplorer.Service.
         It is a SEPARATE project with no ProjectReference here, and its dependency
         closure (System.Text.Json/Microsoft.Extensions.AI/Hosting.Abstractions 10.x,
         pulled by ModelContextProtocol) is INCOMPATIBLE with the 8.x assemblies the
         Service ships. Co-locating them in one folder makes one of the two deps.json
         unsatisfiable -> "Could not load file or assembly 'System.Text.Json,
         Version=10.0.0.0'" and the MCP server crashes on launch. A dedicated
         self-contained subfolder ships the MCP's complete, self-consistent closure
         next to its exe. ProjectsManager.CreateCopilotCliMcpConfig points Copilot at
         app_service/mcp/MdExplorer.Mcp.exe.
         extraResources in package.json copies service_payload/**/* recursively, so the
         mcp/ subfolder reaches app_service/mcp automatically.
         Self-contained is REQUIRED: the client has no .NET runtime installed. -->
    <PropertyGroup>
      <McpProjectPath>$(MSBuildThisFileDirectory)..\MdExplorer.Mcp\MdExplorer.Mcp.csproj</McpProjectPath>
      <McpPublishDest>$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\mcp</McpPublishDest>
      <!-- The apphost has no .exe extension on non-Windows RIDs -->
      <McpExeName Condition="$(RuntimeIdentifier.StartsWith('win'))">MdExplorer.Mcp.exe</McpExeName>
      <McpExeName Condition="!$(RuntimeIdentifier.StartsWith('win'))">MdExplorer.Mcp</McpExeName>
      <McpExeDest>$(McpPublishDest)\$(McpExeName)</McpExeDest>
    </PropertyGroup>

    <!-- Remove any stale top-level MCP files left by the PRIOR layout (when the MCP
         was published directly into service_payload, before the mcp/ subfolder split).
         publish runs with DeleteExistingFiles=false, so without this they would persist,
         ship into app_service/ alongside the Service, and make the runtime self-heal in
         ProjectsManager.McpEntryLaunchTargetMissing see the old exe as still-present ->
         it would keep Copilot pointed at the broken top-level exe instead of mcp/. -->
    <ItemGroup>
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp" />
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp.exe" />
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp.dll" />
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp.deps.json" />
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp.pdb" />
      <StaleTopLevelMcp Include="$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\MdExplorer.Mcp.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(StaleTopLevelMcp)" />

    <Message Text="Publishing MdExplorer.Mcp (self-contained $(RuntimeIdentifier)) into service_payload/mcp..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(McpProjectPath)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=false -o &quot;$(McpPublishDest)&quot;" />

    <!-- Fail-loud: the installer must never ship without the MCP server. -->
    <Error Condition="!Exists('$(McpExeDest)')"
           Text="$(McpExeName) was NOT produced in service_payload/mcp ('$(McpExeDest)'). The MCP server would be missing from the installer and Mark could not read Jira/Confluence. Check the dotnet publish output above." />
    <Message Text="$(McpExeName) published into service_payload/mcp" Importance="high" />

    <!-- Publish the MdExplorer.Scheduler satellite into its OWN isolated subfolder
         service_payload/scheduler (-> app_service/scheduler), same pattern as mcp/.
         It fires the TEMPORAL (cron) triggers of *.agent.md schedules while the full
         Service is off (Electron agent mode): Electron spawns it in BOTH startup modes.
         Self-contained is REQUIRED: the client has no .NET runtime installed.
         extraResources in package.json copies service_payload/**/* recursively, so the
         scheduler/ subfolder reaches app_service/scheduler automatically. -->
    <PropertyGroup>
      <SchedulerProjectPath>$(MSBuildThisFileDirectory)..\MdExplorer.Scheduler\MdExplorer.Scheduler.csproj</SchedulerProjectPath>
      <SchedulerPublishDest>$(MSBuildThisFileDirectory)..\ElectronMdExplorer\service_payload\scheduler</SchedulerPublishDest>
      <!-- The apphost has no .exe extension on non-Windows RIDs -->
      <SchedulerExeName Condition="$(RuntimeIdentifier.StartsWith('win'))">MdExplorer.Scheduler.exe</SchedulerExeName>
      <SchedulerExeName Condition="!$(RuntimeIdentifier.StartsWith('win'))">MdExplorer.Scheduler</SchedulerExeName>
      <SchedulerExeDest>$(SchedulerPublishDest)\$(SchedulerExeName)</SchedulerExeDest>
    </PropertyGroup>

    <Message Text="Publishing MdExplorer.Scheduler (self-contained $(RuntimeIdentifier)) into service_payload/scheduler..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(SchedulerProjectPath)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=false -o &quot;$(SchedulerPublishDest)&quot;" />

    <!-- Fail-loud: shipping without the scheduler would mean scheduled agents silently never fire. -->
    <Error Condition="!Exists('$(SchedulerExeDest)')"
           Text="$(SchedulerExeName) was NOT produced in service_payload/scheduler ('$(SchedulerExeDest)'). Scheduled .agent.md agents would silently never fire. Check the dotnet publish output above." />
    <Message Text="$(SchedulerExeName) published into service_payload/scheduler" Importance="high" />
  </Target>
  
