<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>x64</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>../ElectronMdExplorer/service_payload</PublishUrl>
    <!-- PublishUrl lo legge solo Visual Studio: `dotnet publish -p:PublishProfile=…` scrive in PublishDir (11/10/2026:
         senza questa riga finiva in bin/Release/…/publish e service_payload restava vecchio). -->
    <PublishDir>../ElectronMdExplorer/service_payload/</PublishDir>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <ProjectGuid>28ea8c73-d2ff-422a-88d0-584b0ff2b29c</ProjectGuid>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>