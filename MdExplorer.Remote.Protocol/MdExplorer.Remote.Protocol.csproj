<Project Sdk="Microsoft.NET.Sdk">

  <!-- I messaggi tra il backend e MDE Remote mde-remote (sprint Cartella-Remota-Via-SSH): una sola definizione per i due
       lati. Compatibile con Native AOT: niente riflessione, JSON solo dal source generator. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Namespace MdExplorer.RemoteProtocol, non MdExplorer.Remote.Protocol: «Remote» come namespace coprirebbe il tipo
         Remote di LibGit2Sharp in tutto il codice MdExplorer.* -->
    <RootNamespace>MdExplorer.RemoteProtocol</RootNamespace>
  </PropertyGroup>

</Project>
