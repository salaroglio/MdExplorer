<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migration del database del GRAFO DEL CODICE (%AppData%/MdEngineCode_{hash}.db, uno per progetto).
    Questo database è aperto SOLO con Microsoft.Data.Sqlite (ha FTS5): anche il runner delle migration
    deve usare quella libreria, vedi MdExplorer.Features.Services.CodeGraph.CodeGraphDatabase.
    Sprint: docs-internal/Sprints/2026-10-09-Grafo-Del-Codice.md (D2).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="3.2.17" />
    <PackageReference Include="FluentMigrator.Abstractions" Version="3.2.17" />
  </ItemGroup>

</Project>
