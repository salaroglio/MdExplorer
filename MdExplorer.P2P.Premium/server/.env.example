# MdExplorer P2P Tracker - Environment Configuration
# Copy this file to .env and adjust values as needed

# Node environment
NODE_ENV=production

# Tracker ports (all use same port by default)
TRACKER_HTTP_PORT=8000
TRACKER_UDP_PORT=8000
TRACKER_WS_PORT=8000

# Enable/disable protocols
TRACKER_HTTP=true
TRACKER_UDP=true
TRACKER_WS=true

# Stats logging interval (milliseconds)
TRACKER_STATS_INTERVAL=60000

# Trust proxy headers (set to true if behind nginx/reverse proxy)
TRUST_PROXY=false
